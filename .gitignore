# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node & Python dependencies (recursive)
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Builds & caches
dist/
dist-ssr/
build/
.cache/
.pytest_cache/
*.local

# Database & runtime storage
*.db
*.sqlite
*.sqlite3
redis-data/
postgres_data/

# Model weights, binaries & compiled libraries
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.jit
*.so
*.dll
*.dylib
*.a

# Uploads & custom audio references
uploads/voice-samples/*
!uploads/voice-samples/.gitkeep
uploads/*
fish-speech-int4-patch/references/*
!fish-speech-int4-patch/references/.gitkeep

# Secrets & certificates
.env
.env.*
!.env.example
*.pem
*.key

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?

